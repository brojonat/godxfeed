<!DOCTYPE html>
<html>
<head>
    <title>Options Grid</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://d3js.org/d3.v7.min.js"></script>
    <link rel="stylesheet" href="/static/css/options_grid.css">
    <style>
        #loading {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }
        #grid {
            margin: 20px;
        }
    </style>
</head>
<body>
    <div id="loading">Loading...</div>
    <div class="chart-controls">
        <div class="control-row strike-presets">
            <div class="preset-group">
                <span class="preset-label">Strike Range:</span>
                <button data-strikes="5">±5</button>
                <button data-strikes="10">±10</button>
                <button data-strikes="20">±20</button>
                <button data-strikes="50">±50</button>
                <button data-strikes="100">±100</button>
                <button data-strikes="0">All</button>
            </div>
        </div>
        <div class="control-row datetime-container">
            <label for="expiryStartDate">Start Date: </label>
            <input type="date" id="expiryStartDate">
            <label for="expiryEndDate">End Date: </label>
            <input type="date" id="expiryEndDate">
        </div>
        <div class="control-row auto-update-control">
            <label class="switch">
                <input type="checkbox" id="autoUpdateToggle" checked>
                <span class="slider round"></span>
            </label>
            <span class="toggle-label">Auto-update</span>
        </div>
    </div>
    <div id="grid"></div>
    <script type="module" src="{{ .Endpoint }}/static/js/config.js"></script>
    <script type="module" src="{{ .Endpoint }}/static/js/options_grid.js"></script>
</body>
</html>